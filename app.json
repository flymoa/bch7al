{
  "expo": {
    "name": "bch7al?",
    "slug": "bch7al",
    "version": "4.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1340",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bch7al.app"
    },
    "scheme": "bch7al",
    "plugins": [
      "./plugins/withBlankLaunchIcon",
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1340",
          "image": "./assets/splash-blank.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "bch7al? utilise l'appareil photo pour lire tes tickets de caisse.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "bch7al? utilise l'appareil photo pour lire tes tickets de caisse.",
          "photosPermission": "bch7al? ouvre tes photos pour lire un ticket de caisse."
        }
      ]
    ],
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": ""
    },
    "backgroundColor": "#FFFFFF"
  }
}
